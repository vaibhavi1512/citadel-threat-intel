# Local setup: copy this file to .env. Development auth generates a temporary key per backend process when JWT_SECRET_KEY is blank.
# Local setup: copy this file to .env. Development auth generates a temporary key per backend process when JWT_SECRET_KEY is blank.
# DEMO REQUIRED VARIABLES
# Render supplies PORT automatically. Locally, BACKEND_PORT keeps the existing 8001 default.
PORT=
BACKEND_PORT=8001
ENVIRONMENT=development
MONGO_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional for local development; when omitted, a secure temporary key is generated per backend process.
# Production must set JWT_SECRET_KEY as a server-side environment variable.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_USERS_PATH=data/auth_users.json
# Restrict after deployment, for example: CORS_ORIGINS=http://localhost:5173,https://YOUR-VERCEL-DOMAIN.vercel.app
MODEL_AUTO_TRAIN_PRIMARY=true
MODEL_AUTO_TRAIN_SECONDARY=false
MODEL_ALLOW_RUNTIME_DOWNLOADS=false
WEBHOOKS_ENABLED=false
REPORTING_ENABLED=false
REPORT_SIGNING_ENABLED=false
REPORT_SIGNING_DEV_AUTO_GENERATE=true
REPORT_SIGNED_REPORT_EXPIRY_DAYS=30
REPORT_VERIFICATION_CACHE_TTL_SECONDS=60

# Frontend build variable (set in frontend-react/.env.local or Vercel settings).
# Vercel production example: VITE_API_BASE_URL=https://YOUR-RENDER-BACKEND-URL
VITE_API_BASE_URL=http://127.0.0.1:8107

# OPTIONAL INTELLIGENCE PROVIDERS
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
PASTEBIN_API_KEY=
DEHASHED_EMAIL=
DEHASHED_API_KEY=
GITHUB_TOKEN=
INTELX_API_KEY=
INTELX_API_BASE=https://free.intelx.io
LEAKIX_API_KEY=
PUBLIC_INTEL_MAX_ITEMS=10
PUBLIC_INTEL_REQUEST_TIMEOUT=12

# OPTIONAL MONGODB (set MONGO_ENABLED=true to use it)
MONGO_URI=
MONGO_DB_NAME=dark_web_threat_intel
MONGO_COLLECTION=analyses

# OPTIONAL EMAIL / CYBER CELL REPORT DELIVERY
REPORTING_MOCK_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_DEFAULT_CC=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
CYBER_CELL_DAILY_SEND_LIMIT=3
CYBER_CELL_PREVIEW_TTL_SECONDS=1800

# OPTIONAL REPORT SIGNING
REPORT_PRIVATE_KEY_PATH=keys/private_key.pem
REPORT_PUBLIC_KEY_PATH=keys/public_key.pem
REPORT_VERIFICATION_BASE_URL=http://127.0.0.1:5173
ENV=

# OPTIONAL TUNING
WATCHLIST_DEFAULT_INTERVAL_SECONDS=300
WATCHLIST_MIN_INTERVAL_SECONDS=60
WEBHOOK_TIMEOUT_SECONDS=10
MONITORING_STATE_PATH=data/monitoring_state.json
DEBUG_REJECTED_NOISE=false
